---
import {
  extractPostTags,
  formatDateISO,
  getTagHref,
  type BlogPost,
} from "@/utils/blog";

export interface Props {
  post: BlogPost;
  showDescription?: boolean;
}

const { post, showDescription = true } = Astro.props;
const displayDate = post.data.modDatetime ?? post.data.pubDatetime;
const tags = extractPostTags(post.data.tags);
---

<article class="group py-4 transition-colors">
  <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
        <a
          href={`/posts/${post.slug}/`}
          class="text-[16px] font-medium text-ink transition-colors group-hover:text-accent hover:underline hover:decoration-accent/40 hover:underline-offset-4"
        >
          {post.data.title}
        </a>

        {
          tags.length > 0 && (
            <div class="flex flex-wrap items-center gap-1.5">
              {tags.map((tag) => (
                <a
                  href={getTagHref(tag.slug)}
                  class="rounded-md border border-line/80 bg-surface-muted/70 px-1.5 py-0.5 text-[11px] font-medium text-ink-muted transition-colors hover:border-accent/40 hover:text-accent"
                >
                  {tag.label}
                </a>
              ))}
            </div>
          )
        }
      </div>

      {
        showDescription && post.data.description && (
          <p class="mt-1 text-sm leading-relaxed text-ink-muted">
            {post.data.description}
          </p>
        )
      }
    </div>

    <time
      datetime={displayDate.toISOString()}
      class="shrink-0 font-mono text-xs tabular-nums text-ink-faint"
    >
      {formatDateISO(displayDate)}
    </time>
  </div>
</article>
