---
import BaseLayout from "@/layouts/BaseLayout.astro";
import MacosUseSection from "@/components/MacosUseSection.astro";
import ProjectShowcaseCard from "@/components/ProjectShowcaseCard.astro";
import PostRow from "@/components/PostRow.astro";
import { SITE } from "@/site";
import { PROJECTS } from "@/data/projects";
import { getPublishedPosts } from "@/utils/blog";

const allPosts = await getPublishedPosts();
const recentPosts = allPosts.slice(0, 8);
---

<BaseLayout activeNav="home">
  <!-- Hero -->
  <section class="mx-auto max-w-5xl px-4 pb-10 pt-12 sm:px-6 sm:pb-12 sm:pt-16">
    <div class="max-w-2xl">
      <div
        class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3 py-1 text-xs font-medium text-ink-muted shadow-2xs"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
        <span>macOS Apps · Systems · Mathematics</span>
      </div>

      <h1
        class="mt-5 text-4xl font-semibold tracking-tight text-ink sm:text-5xl"
      >
        {SITE.name}
      </h1>

      <p class="mt-4 text-base leading-relaxed text-ink-muted sm:text-lg">
        Building lightweight, native macOS developer utilities and writing notes
        on systems programming, Rust, concurrency, and mathematics.
      </p>

      <div class="mt-6 flex flex-wrap items-center gap-2.5">
        <a
          href={SITE.github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-lg bg-ink px-3.5 py-2 text-sm font-medium text-canvas transition-opacity hover:opacity-90"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
            />
          </svg>
          <span>GitHub</span>
        </a>

        <a
          href={`mailto:${SITE.email}`}
          class="inline-flex items-center gap-2 rounded-lg border border-line bg-surface px-3.5 py-2 text-sm font-medium text-ink transition-colors hover:bg-surface-muted"
        >
          <svg
            class="h-4 w-4 text-ink-muted"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="m3 7 9 6 9-6" />
          </svg>
          <span>{SITE.email}</span>
        </a>

        <a
          href="/rss.xml"
          class="inline-flex items-center gap-1.5 rounded-lg border border-line bg-surface px-3 py-2 text-sm font-medium text-ink-muted transition-colors hover:bg-surface-muted hover:text-ink"
        >
          <svg
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M4 11a9 9 0 0 1 9 9" />
            <path d="M4 4a16 16 0 0 1 16 16" />
            <circle cx="5" cy="19" r="1" fill="currentColor" />
          </svg>
          <span>RSS</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section
    id="projects"
    class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-10"
  >
    <div
      class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between"
    >
      <div>
        <h2 class="text-2xl font-semibold tracking-tight text-ink">
          Projects
        </h2>
        <p class="mt-1 text-sm text-ink-muted">
          Native Swift tools for macOS — distributed via Homebrew and signed
          GitHub Releases.
        </p>
      </div>

      <button
        type="button"
        data-copy-button
        data-copy-text={`brew tap ${SITE.homebrewTap}`}
        data-copy-label={`brew tap ${SITE.homebrewTap}`}
        title="Copy Homebrew tap command"
        class="tap-pill inline-flex w-fit shrink-0 whitespace-nowrap items-center gap-2 rounded-lg border border-line bg-surface px-3 py-1.5 font-mono text-xs text-ink-muted transition-colors hover:border-accent/40 hover:text-ink"
      >
        <span class="select-none text-ink-faint">$</span>
        <span data-copy-text-label>brew tap {SITE.homebrewTap}</span>
        <svg
          class="copy-icon h-3.5 w-3.5 text-ink-faint"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
        </svg>
        <svg
          class="check-icon hidden h-3.5 w-3.5 text-emerald-600 dark:text-emerald-400"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <polyline points="20 6 9 17 4 12" />
        </svg>
      </button>
    </div>

    <div class="space-y-8">
      <MacosUseSection />
      {PROJECTS.map((project) => <ProjectShowcaseCard project={project} />)}
    </div>
  </section>

  <!-- Writing -->
  <section
    id="writing"
    class="mx-auto max-w-5xl px-4 pb-16 pt-10 sm:px-6 sm:pb-20 sm:pt-12"
  >
    <div class="mb-4 flex items-baseline justify-between gap-4">
      <div>
        <h2 class="text-2xl font-semibold tracking-tight text-ink">Writing</h2>
        <p class="mt-1 text-sm text-ink-muted">
          Notes on Rust, concurrency, algorithms, and algebra.
        </p>
      </div>
      <a
        href="/posts/"
        class="shrink-0 text-sm font-medium text-accent transition-opacity hover:opacity-80"
      >
        View all {allPosts.length} posts →
      </a>
    </div>

    <div class="divide-y divide-line border-b border-t border-line">
      {recentPosts.map((post) => <PostRow post={post} />)}
    </div>

    <div class="mt-6 flex flex-wrap items-center justify-between gap-4 text-sm">
      <a
        href="/posts/"
        class="inline-flex items-center gap-1.5 font-medium text-ink transition-colors hover:text-accent"
      >
        <span>All Posts</span>
        <span aria-hidden="true">→</span>
      </a>
      <a
        href="/tags/"
        class="inline-flex items-center gap-1.5 font-medium text-ink-muted transition-colors hover:text-ink"
      >
        <span>Browse by Tag</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .tap-pill[data-copied="true"] {
    border-color: rgb(16 185 129 / 0.5);
    color: light-dark(rgb(5 150 105), rgb(52 211 153));
  }
  .tap-pill[data-copied="true"] .copy-icon {
    display: none;
  }
  .tap-pill[data-copied="true"] .check-icon {
    display: block;
  }
</style>
