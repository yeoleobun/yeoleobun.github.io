---
import { SITE } from "@/site";
---

<footer class="mt-auto border-t border-line/80">
  <div
    class="mx-auto flex max-w-5xl flex-col gap-3 px-4 py-8 text-sm text-ink-muted sm:flex-row sm:items-center sm:justify-between sm:px-6"
  >
    <div class="flex items-center gap-2">
      <span>© 2026 {SITE.name}</span>
      <span class="text-ink-faint" aria-hidden="true">·</span>
      <span class="text-ink-faint">Crafted with Astro</span>
    </div>

    <div class="flex items-center gap-5">
      <a
        href={SITE.github}
        target="_blank"
        rel="noopener noreferrer"
        class="transition-colors hover:text-ink"
      >
        GitHub
      </a>
      <a href={`mailto:${SITE.email}`} class="transition-colors hover:text-ink">
        Email
      </a>
      <a href="/rss.xml" class="transition-colors hover:text-ink">RSS</a>
    </div>
  </div>
</footer>
