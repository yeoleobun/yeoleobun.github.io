---
import { Image } from "astro:assets";
import type { Project } from "@/data/projects";
import InstallSnippet from "@/components/InstallSnippet.astro";

export interface Props {
  project: Project;
}

const { project } = Astro.props;
const isAmber = project.accent === "amber";

const bulletClass = isAmber
  ? "bg-amber-500 dark:bg-amber-400"
  : "bg-emerald-500 dark:bg-emerald-400";

const versionBadgeClass = isAmber
  ? "border-amber-500/25 bg-amber-500/10 text-amber-700 dark:text-amber-300"
  : "border-emerald-500/25 bg-emerald-500/10 text-emerald-700 dark:text-emerald-300";

const stageBgClass = isAmber
  ? "from-amber-50/90 via-slate-100/80 to-orange-50/70 dark:from-amber-950/25 dark:via-slate-900/90 dark:to-slate-900/80"
  : "from-emerald-50/80 via-slate-100/80 to-teal-50/70 dark:from-emerald-950/25 dark:via-slate-900/90 dark:to-slate-900/80";
---

<article
  class="overflow-hidden rounded-2xl border border-line bg-surface shadow-sm transition-shadow hover:shadow-md"
>
  {
    project.layout === "popover" ? (
      <div class="grid lg:grid-cols-12">
        <div class="flex flex-col justify-between gap-6 p-6 sm:p-8 lg:col-span-7">
          <div class="space-y-5">
            <div class="flex items-start gap-4">
              <Image
                src={project.icon}
                alt={`${project.name} app icon`}
                widths={[128, 256]}
                sizes="64px"
                class="h-14 w-14 shrink-0 select-none sm:h-16 sm:w-16"
              />
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="text-2xl font-semibold tracking-tight text-ink">
                    <a
                      href={`/projects/${project.slug}/`}
                      class="transition-colors hover:text-accent"
                    >
                      {project.name}
                    </a>
                  </h3>
                  <span
                    class:list={[
                      "rounded-full border px-2 py-0.5 font-mono text-[11px] font-medium tabular-nums",
                      versionBadgeClass,
                    ]}
                  >
                    {project.version}
                  </span>
                  <span class="rounded-full border border-line bg-surface-muted/70 px-2.5 py-0.5 text-[11px] font-medium text-ink-muted">
                    {project.platform}
                  </span>
                </div>
                <p class="mt-1 text-sm font-medium text-ink-muted">
                  {project.subtitle}
                </p>
              </div>
            </div>

            <p class="text-[15px] leading-relaxed text-ink-muted">
              {project.tagline}
            </p>

            <ul class="space-y-2 text-sm text-ink/90">
              {project.highlights.map((item) => (
                <li class="flex items-start gap-2.5">
                  <span
                    class:list={["mt-2 h-1.5 w-1.5 shrink-0 rounded-full", bulletClass]}
                    aria-hidden="true"
                  />
                  <span class="leading-relaxed">{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="space-y-4">
            <InstallSnippet
              homebrew={project.quickInstall.homebrew}
              curl={project.quickInstall.curl}
            />

            <div class="flex flex-wrap items-center gap-2.5">
              <a
                href={`/projects/${project.slug}/`}
                class="inline-flex items-center gap-1.5 rounded-lg bg-ink px-3.5 py-2 text-sm font-medium text-canvas transition-opacity hover:opacity-90"
              >
                <span>Project Details</span>
                <span aria-hidden="true">→</span>
              </a>
              <a
                href={project.repoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 rounded-lg border border-line bg-surface px-3.5 py-2 text-sm font-medium text-ink transition-colors hover:bg-surface-muted"
              >
                <span>GitHub</span>
                <span aria-hidden="true">↗</span>
              </a>
              <a
                href={project.releaseUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 rounded-lg border border-line bg-surface px-3.5 py-2 text-sm font-medium text-ink-muted transition-colors hover:bg-surface-muted hover:text-ink"
              >
                <span>Download .dmg</span>
              </a>
            </div>
          </div>
        </div>

        <div
          class:list={[
            "flex items-center justify-center border-t border-line/70 bg-gradient-to-br p-6 sm:p-8 lg:col-span-5 lg:border-l lg:border-t-0",
            stageBgClass,
          ]}
        >
          <Image
            src={project.screenshot}
            alt={project.screenshotAlt}
            widths={[480, 800]}
            sizes="(max-width: 1024px) 100vw, 380px"
            class="mx-auto max-h-[430px] w-auto object-contain drop-shadow-sm"
          />
        </div>
      </div>
    ) : (
      <div class="flex flex-col">
        <div class="p-6 sm:p-8">
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div class="flex items-start gap-4">
              <Image
                src={project.icon}
                alt={`${project.name} app icon`}
                widths={[128, 256]}
                sizes="64px"
                class="h-14 w-14 shrink-0 select-none sm:h-16 sm:w-16"
              />
              <div>
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="text-2xl font-semibold tracking-tight text-ink">
                    <a
                      href={`/projects/${project.slug}/`}
                      class="transition-colors hover:text-accent"
                    >
                      {project.name}
                    </a>
                  </h3>
                  <span
                    class:list={[
                      "rounded-full border px-2 py-0.5 font-mono text-[11px] font-medium tabular-nums",
                      versionBadgeClass,
                    ]}
                  >
                    {project.version}
                  </span>
                  <span class="rounded-full border border-line bg-surface-muted/70 px-2.5 py-0.5 text-[11px] font-medium text-ink-muted">
                    {project.platform}
                  </span>
                </div>
                <p class="mt-1 text-sm font-medium text-ink-muted">
                  {project.subtitle}
                </p>
              </div>
            </div>

            <div class="flex flex-wrap items-center gap-1.5">
              {project.stack.map((tech) => (
                <span class="rounded-md border border-line bg-surface-muted/60 px-2 py-0.5 font-mono text-[11px] text-ink-muted">
                  {tech}
                </span>
              ))}
            </div>
          </div>

          <div class="mt-6 grid gap-6 lg:grid-cols-12 lg:items-start">
            <div class="space-y-4 lg:col-span-6">
              <p class="text-[15px] leading-relaxed text-ink-muted">
                {project.tagline}
              </p>

              <ul class="space-y-2 text-sm text-ink/90">
                {project.highlights.map((item) => (
                  <li class="flex items-start gap-2.5">
                    <span
                      class:list={["mt-2 h-1.5 w-1.5 shrink-0 rounded-full", bulletClass]}
                      aria-hidden="true"
                    />
                    <span class="leading-relaxed">{item}</span>
                  </li>
                ))}
              </ul>

              <div class="flex flex-wrap items-center gap-2.5 pt-1">
                <a
                  href={`/projects/${project.slug}/`}
                  class="inline-flex items-center gap-1.5 rounded-lg bg-ink px-3.5 py-2 text-sm font-medium text-canvas transition-opacity hover:opacity-90"
                >
                  <span>Project Details</span>
                  <span aria-hidden="true">→</span>
                </a>
                <a
                  href={project.repoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 rounded-lg border border-line bg-surface px-3.5 py-2 text-sm font-medium text-ink transition-colors hover:bg-surface-muted"
                >
                  <span>GitHub</span>
                  <span aria-hidden="true">↗</span>
                </a>
                <a
                  href={project.releaseUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 rounded-lg border border-line bg-surface px-3.5 py-2 text-sm font-medium text-ink-muted transition-colors hover:bg-surface-muted hover:text-ink"
                >
                  <span>Download .dmg</span>
                </a>
              </div>
            </div>

            <div class="space-y-3 lg:col-span-6">
              <InstallSnippet
                homebrew={project.quickInstall.homebrew}
                curl={project.quickInstall.curl}
              />
              <p class="text-xs leading-relaxed text-ink-faint">
                Native SwiftUI Liquid Glass interface · 0% background CPU when idle · Opens worktrees directly in your editor or terminal.
              </p>
            </div>
          </div>
        </div>

        <div
          class:list={[
            "border-t border-line/70 bg-gradient-to-br px-4 pb-4 pt-5 sm:px-10 sm:pb-7 sm:pt-8",
            stageBgClass,
          ]}
        >
          <Image
            src={project.screenshot}
            alt={project.screenshotAlt}
            widths={[800, 1400, 2352]}
            sizes="(max-width: 1024px) 100vw, 960px"
            class="mx-auto h-auto w-full max-w-4xl object-contain"
          />
        </div>
      </div>
    )
  }
</article>
