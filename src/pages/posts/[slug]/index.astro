---
import { render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  estimateReadingTime,
  extractPostTags,
  formatDateISO,
  getPublishedPosts,
  getTagHref,
  type BlogPost,
} from "@/utils/blog";
import { SITE } from "@/site";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      newerPost: index > 0 ? posts[index - 1] : null,
      olderPost: index < posts.length - 1 ? posts[index + 1] : null,
    },
  }));
}

export interface Props {
  post: BlogPost;
  newerPost: BlogPost | null;
  olderPost: BlogPost | null;
}

const { post, newerPost, olderPost } = Astro.props;
const { Content } = await render(post);

const tags = extractPostTags(post.data.tags);
const readingTime = estimateReadingTime(post.body ?? "");
const pubDateStr = formatDateISO(post.data.pubDatetime);
const modDateStr = post.data.modDatetime
  ? formatDateISO(post.data.modDatetime)
  : null;
---

<BaseLayout
  title={`${post.data.title} — ${SITE.title}`}
  description={post.data.description ?? `${post.data.title} — ${SITE.title}`}
  activeNav="writing"
  type="article"
  pubDatetime={post.data.pubDatetime}
  modDatetime={post.data.modDatetime}
>
  <div
    class="fixed left-0 top-0 z-50 h-0.5 w-full bg-transparent pointer-events-none"
    aria-hidden="true"
  >
    <div id="reading-progress" class="h-full w-0 bg-accent transition-[width] duration-75"></div>
  </div>

  <article class="mx-auto max-w-3xl px-4 pb-20 pt-10 sm:px-6 sm:pt-12">
    <div class="mb-8">
      <a
        href="/posts/"
        class="inline-flex items-center gap-1.5 text-sm font-medium text-ink-muted transition-colors hover:text-ink"
      >
        <span aria-hidden="true">←</span>
        <span>All Writing</span>
      </a>
    </div>

    <header class="border-b border-line pb-7">
      <h1 class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
        {post.data.title}
      </h1>

      {
        post.data.description && (
          <p class="mt-3 text-base leading-relaxed text-ink-muted">
            {post.data.description}
          </p>
        )
      }

      <div
        class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-xs text-ink-faint"
      >
        <time datetime={post.data.pubDatetime.toISOString()} class="tabular-nums">
          Published {pubDateStr}
        </time>
        {
          modDateStr && modDateStr !== pubDateStr && (
            <time
              datetime={post.data.modDatetime!.toISOString()}
              class="tabular-nums"
            >
              Updated {modDateStr}
            </time>
          )
        }
        <span>{readingTime}</span>
      </div>

      {
        tags.length > 0 && (
          <div class="mt-4 flex flex-wrap items-center gap-1.5">
            {tags.map((tag) => (
              <a
                href={getTagHref(tag.slug)}
                class="rounded-md border border-line bg-surface-muted/70 px-2 py-0.5 text-xs font-medium text-ink-muted transition-colors hover:border-accent/40 hover:text-accent"
              >
                # {tag.label}
              </a>
            ))}
          </div>
        )
      }
    </header>

    <div id="article-content" class="article-prose mt-8">
      <Content />
    </div>

    <!-- Post Navigation -->
    {
      (newerPost || olderPost) && (
        <nav
          aria-label="Article navigation"
          class="mt-14 grid gap-4 border-t border-line pt-8 sm:grid-cols-2"
        >
          {newerPost ? (
            <a
              href={`/posts/${newerPost.id}/`}
              class="group rounded-xl border border-line bg-surface p-4 transition-colors hover:border-accent/40"
            >
              <span class="text-xs font-medium text-ink-faint">
                ← Newer Post
              </span>
              <div class="mt-1 font-medium text-ink transition-colors group-hover:text-accent">
                {newerPost.data.title}
              </div>
            </a>
          ) : (
            <div />
          )}

          {olderPost && (
            <a
              href={`/posts/${olderPost.id}/`}
              class="group rounded-xl border border-line bg-surface p-4 text-right transition-colors hover:border-accent/40"
            >
              <span class="text-xs font-medium text-ink-faint">
                Older Post →
              </span>
              <div class="mt-1 font-medium text-ink transition-colors group-hover:text-accent">
                {olderPost.data.title}
              </div>
            </a>
          )}
        </nav>
      )
    }
  </article>

  <script is:inline>
    (function () {
      var progressBar = document.getElementById("reading-progress");
      function updateProgress() {
        if (!progressBar) return;
        var scrollTop =
          document.documentElement.scrollTop || document.body.scrollTop;
        var maxScroll =
          document.documentElement.scrollHeight -
          document.documentElement.clientHeight;
        var pct = maxScroll > 0 ? Math.min(100, (scrollTop / maxScroll) * 100) : 0;
        progressBar.style.width = pct.toFixed(2) + "%";
      }
      window.addEventListener("scroll", updateProgress, { passive: true });
      updateProgress();

      var article = document.getElementById("article-content");
      if (!article) return;

      var headings = article.querySelectorAll("h2[id], h3[id], h4[id]");
      headings.forEach(function (heading) {
        heading.classList.add("group");
        var anchor = document.createElement("a");
        anchor.href = "#" + heading.id;
        anchor.className = "heading-anchor";
        anchor.setAttribute("aria-label", "Link to section");
        anchor.textContent = "#";
        heading.appendChild(anchor);
      });

      var blocks = article.querySelectorAll("pre");
      blocks.forEach(function (pre) {
        var wrapper = document.createElement("div");
        wrapper.className = "relative group";
        pre.parentNode.insertBefore(wrapper, pre);
        wrapper.appendChild(pre);

        var btn = document.createElement("button");
        btn.type = "button";
        btn.textContent = "Copy";
        btn.className =
          "absolute right-2.5 top-2.5 rounded-md border border-line bg-surface/90 px-2 py-1 font-mono text-[11px] font-medium text-ink-muted opacity-0 backdrop-blur-sm transition-opacity group-hover:opacity-100 focus:opacity-100 hover:text-ink";

        btn.addEventListener("click", function () {
          var code = pre.querySelector("code");
          var text = code ? code.innerText : pre.innerText;
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(function () {
              btn.textContent = "Copied";
              setTimeout(function () {
                btn.textContent = "Copy";
              }, 1200);
            });
          }
        });

        wrapper.appendChild(btn);
      });
    })();
  </script>
</BaseLayout>
