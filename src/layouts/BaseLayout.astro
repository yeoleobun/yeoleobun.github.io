---
import "@/styles/global.css";
import { SITE } from "@/site";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

export interface Props {
  title?: string;
  description?: string;
  activeNav?: "home" | "projects" | "writing";
  type?: "website" | "article";
  pubDatetime?: Date;
  modDatetime?: Date | null;
}

const {
  title = `${SITE.title} — ${SITE.tagline}`,
  description = SITE.description,
  activeNav = "home",
  type = "website",
  pubDatetime,
  modDatetime,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const rssURL = new URL("/rss.xml", Astro.site ?? SITE.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      try {
        var stored = localStorage.getItem("color-scheme");
        if (stored === "light" || stored === "dark") {
          document.querySelector('meta[name="color-scheme"]').content = stored;
        }
      } catch (e) {}
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href={rssURL}
    />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-accent focus:px-3 focus:py-2 focus:text-sm focus:font-medium focus:text-white"
    >
      Skip to content
    </a>

    <Header activeNav={activeNav} />

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <Footer />

    <script is:inline>
      (function () {
        var meta = document.querySelector('meta[name="color-scheme"]');
        var themeBtn = document.getElementById("theme-toggle");
        var mql = window.matchMedia("(prefers-color-scheme: dark)");

        function getSystemScheme() {
          return mql.matches ? "dark" : "light";
        }

        function getRenderedScheme() {
          if (meta && (meta.content === "dark" || meta.content === "light")) {
            return meta.content;
          }
          return getSystemScheme();
        }

        function updateThemeLabel() {
          if (!themeBtn) return;
          var current = getRenderedScheme();
          var label =
            current === "dark" ? "Switch to light mode" : "Switch to dark mode";
          themeBtn.setAttribute("aria-label", label);
          themeBtn.setAttribute("title", label);
        }

        updateThemeLabel();

        if (themeBtn && meta) {
          themeBtn.addEventListener("click", function () {
            var target = getRenderedScheme() === "dark" ? "light" : "dark";
            if (target !== getSystemScheme()) {
              meta.content = target;
              try {
                localStorage.setItem("color-scheme", target);
              } catch (e) {}
            } else {
              meta.content = "light dark";
              try {
                localStorage.removeItem("color-scheme");
              } catch (e) {}
            }
            updateThemeLabel();
          });
        }

        window.addEventListener("storage", function (event) {
          if (event.key !== "color-scheme" || !meta) return;
          meta.content =
            event.newValue === "light" || event.newValue === "dark"
              ? event.newValue
              : "light dark";
          updateThemeLabel();
        });

        try {
          mql.addEventListener("change", updateThemeLabel);
        } catch (e) {}

        var lastCopyMessage = "";
        var copyTimers = new WeakMap();

        function getStatusRegion(button) {
          var next = button.nextElementSibling;
          if (next && next.hasAttribute("data-copy-status")) return next;
          var globalStatus = document.getElementById("global-copy-status");
          if (!globalStatus) {
            globalStatus = document.createElement("span");
            globalStatus.id = "global-copy-status";
            globalStatus.className = "sr-only";
            globalStatus.setAttribute("role", "status");
            document.body.appendChild(globalStatus);
          }
          return globalStatus;
        }

        function reportCopy(button, ok) {
          var original = button.getAttribute("data-copy-label") || "Copy";
          var labelEl = button.querySelector("[data-copy-text-label]");
          var statusEl = getStatusRegion(button);
          clearTimeout(copyTimers.get(button));
          button.removeAttribute("data-copied");
          button.removeAttribute("data-failed");

          var message = ok ? "Copied" : "Copy failed";
          if (message === lastCopyMessage) message += "\u00A0";
          lastCopyMessage = message;

          statusEl.textContent = "";
          button.setAttribute(ok ? "data-copied" : "data-failed", "true");
          if (labelEl) {
            labelEl.textContent = ok ? "Copied" : "Failed";
          }
          requestAnimationFrame(function () {
            statusEl.textContent = message;
          });

          copyTimers.set(
            button,
            setTimeout(function () {
              button.removeAttribute("data-copied");
              button.removeAttribute("data-failed");
              if (labelEl) {
                labelEl.textContent = original;
              }
              statusEl.textContent = "";
            }, 1500)
          );
        }

        async function performCopy(button, target) {
          var text = target
            ? target.matches("input, textarea")
              ? target.value
              : target.innerText.trim()
            : button.getAttribute("data-copy-text");
          if (!text) return;
          try {
            await navigator.clipboard.writeText(text);
            reportCopy(button, true);
          } catch (e) {
            reportCopy(button, false);
          }
        }

        function activateInstallTab(tabBtn) {
          var box = tabBtn.closest("[data-install-box]");
          if (!box) return;
          var mode = tabBtn.getAttribute("data-install-tab");
          var cmd = tabBtn.getAttribute("data-install-command") || "";
          var codeEl = box.querySelector("[data-install-code]");
          var panelEl = box.querySelector("[data-install-panel]");
          var copyBtn = box.querySelector("[data-copy-button]");
          if (codeEl) codeEl.textContent = cmd;
          if (copyBtn) copyBtn.setAttribute("data-copy-text", cmd);
          if (panelEl && tabBtn.id) {
            panelEl.setAttribute("aria-labelledby", tabBtn.id);
          }

          var tabs = box.querySelectorAll("[data-install-tab]");
          tabs.forEach(function (t) {
            var active = t.getAttribute("data-install-tab") === mode;
            t.setAttribute("aria-selected", active ? "true" : "false");
            t.toggleAttribute("focusgroupstart", active);
            t.setAttribute("tabindex", active ? "0" : "-1");
          });
        }

        document.addEventListener(
          "command",
          function (event) {
            if (event.command === "--copy" && event.source) {
              performCopy(event.source, event.target);
            }
          },
          true
        );

        document.addEventListener("keydown", function (event) {
          var target = event.target;
          if (!(target instanceof Element)) return;
          var tabBtn = target.closest("[role='tablist'] [role='tab']");
          if (!tabBtn) return;

          var keys = ["ArrowLeft", "ArrowRight", "Home", "End"];
          if (keys.indexOf(event.key) === -1) return;

          var tablist = tabBtn.closest("[role='tablist']");
          if (!tablist) return;
          var tabs = Array.prototype.slice.call(
            tablist.querySelectorAll("[role='tab']")
          );
          var idx = tabs.indexOf(tabBtn);
          if (idx === -1) return;

          event.preventDefault();
          var nextIdx = idx;
          if (event.key === "ArrowRight") nextIdx = (idx + 1) % tabs.length;
          else if (event.key === "ArrowLeft")
            nextIdx = (idx - 1 + tabs.length) % tabs.length;
          else if (event.key === "Home") nextIdx = 0;
          else if (event.key === "End") nextIdx = tabs.length - 1;

          var nextTab = tabs[nextIdx];
          if (nextTab) {
            activateInstallTab(nextTab);
            nextTab.focus();
          }
        });

        document.addEventListener("click", function (event) {
          var target = event.target;
          if (!(target instanceof Element)) return;

          var tabBtn = target.closest("[data-install-tab]");
          if (tabBtn) {
            activateInstallTab(tabBtn);
            return;
          }

          var invokerBtn = target.closest('button[command="--copy"]');
          if (invokerBtn) {
            if (!("CommandEvent" in window)) {
              var cmdTarget = document.getElementById(
                invokerBtn.getAttribute("commandfor") || ""
              );
              performCopy(invokerBtn, cmdTarget);
            }
            return;
          }

          var copyBtn = target.closest("[data-copy-button]");
          if (copyBtn) {
            performCopy(copyBtn, null);
          }
        });
      })();
    </script>
  </body>
</html>
