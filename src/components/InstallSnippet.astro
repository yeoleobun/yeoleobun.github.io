---
export interface Props {
  homebrew: string;
  curl: string;
}

const { homebrew, curl } = Astro.props;
const uid = Math.random().toString(36).slice(2, 9);
const homebrewTabId = `install-tab-hb-${uid}`;
const curlTabId = `install-tab-curl-${uid}`;
const codeId = `install-code-${uid}`;
---

<div
  data-install-box
  class="overflow-hidden rounded-xl border border-line bg-surface-muted/65"
>
  <div
    class="flex items-center justify-between gap-2 border-b border-line/70 px-3 py-1.5"
  >
    <div
      class="flex items-center gap-1"
      role="tablist"
      {...({ focusgroup: "tablist nomemory" } as Record<string, unknown>)}
      aria-label="Install method"
    >
      <button
        id={homebrewTabId}
        type="button"
        role="tab"
        aria-selected="true"
        {...({ focusgroupstart: "" } as Record<string, unknown>)}
        data-install-tab="homebrew"
        data-install-command={homebrew}
        class="install-tab relative rounded-md px-2 py-0.5 text-xs font-medium text-ink-muted transition-colors hover:text-ink"
      >
        Homebrew
      </button>
      <button
        id={curlTabId}
        type="button"
        role="tab"
        aria-selected="false"
        tabindex="-1"
        data-install-tab="curl"
        data-install-command={curl}
        class="install-tab relative rounded-md px-2 py-0.5 text-xs font-medium text-ink-muted transition-colors hover:text-ink"
      >
        curl
      </button>
    </div>

    <span class="relative inline-flex items-center">
      <button
        type="button"
        {...({ command: "--copy", commandfor: codeId } as Record<string, unknown>)}
        data-copy-button
        data-copy-text={homebrew}
        data-copy-label="Copy"
        class="copy-btn inline-flex min-h-6 min-w-6 items-center gap-1.5 rounded-md px-2 py-0.5 text-xs font-medium text-ink-muted transition-colors hover:bg-surface hover:text-ink"
      >
        <svg
          class="copy-icon h-3.5 w-3.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
        </svg>
        <svg
          class="check-icon hidden h-3.5 w-3.5 text-emerald-600 dark:text-emerald-400"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <polyline points="20 6 9 17 4 12" />
        </svg>
        <span data-copy-text-label>Copy</span>
      </button>
      <span class="sr-only" role="status" data-copy-status></span>
    </span>
  </div>

  <div
    role="tabpanel"
    aria-labelledby={homebrewTabId}
    tabindex="0"
    data-install-panel
    class="flex items-start gap-2 overflow-x-auto px-3.5 py-2.5 font-mono text-[12.5px] leading-relaxed"
  >
    <span class="select-none text-ink-faint" aria-hidden="true">$</span>
    <code id={codeId} data-install-code class="whitespace-pre text-ink">{homebrew}</code>
  </div>
</div>

<style>
  .install-tab[aria-selected="true"] {
    background-color: rgb(var(--surface));
    color: rgb(var(--ink));
  }
  .install-tab[aria-selected="true"]::after {
    content: "";
    position: absolute;
    inset: auto 0.35rem 0;
    border-block-end: 2px solid rgb(var(--accent));
  }
  .copy-btn[data-copied="true"] {
    color: light-dark(rgb(5 150 105), rgb(52 211 153));
  }
  .copy-btn[data-copied="true"] .copy-icon {
    display: none;
  }
  .copy-btn[data-copied="true"] .check-icon {
    display: block;
  }
</style>
