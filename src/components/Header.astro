---
import { SITE } from "@/site";

export interface Props {
  activeNav?: "home" | "projects" | "writing";
}

const { activeNav = "home" } = Astro.props;
---

<header
  class="sticky top-0 z-40 border-b border-line/80 bg-canvas/85 backdrop-blur-md"
>
  <div
    class="mx-auto flex h-16 max-w-5xl items-center justify-between gap-4 px-4 sm:px-6"
  >
    <a
      href="/"
      class="group inline-flex items-center gap-2.5 rounded-lg py-1 font-semibold tracking-tight text-ink transition-colors hover:text-accent"
    >
      <span
        class="flex h-7 w-7 items-center justify-center rounded-lg border border-line bg-surface shadow-2xs transition-colors group-hover:border-accent/40"
        aria-hidden="true"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none">
          <path
            d="M7 6.5L12 13.5M17 6.5L12 13.5M12 13.5V18.5"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <circle cx="17.5" cy="17.5" r="1.5" class="fill-accent" />
        </svg>
      </span>
      <span class="text-[15px]">{SITE.name}</span>
    </a>

    <nav aria-label="Primary navigation" class="flex items-center gap-1 sm:gap-2">
      <a
        href="/projects/"
        class:list={[
          "rounded-lg px-2.5 py-1.5 text-sm font-medium transition-colors",
          activeNav === "projects"
            ? "bg-surface-muted text-ink"
            : "text-ink-muted hover:bg-surface-muted/70 hover:text-ink",
        ]}
      >
        Projects
      </a>
      <a
        href="/posts/"
        class:list={[
          "rounded-lg px-2.5 py-1.5 text-sm font-medium transition-colors",
          activeNav === "writing"
            ? "bg-surface-muted text-ink"
            : "text-ink-muted hover:bg-surface-muted/70 hover:text-ink",
        ]}
      >
        Writing
      </a>

      <span class="mx-1.5 hidden h-4 w-px bg-line sm:inline-block" aria-hidden="true"></span>

      <a
        href={SITE.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        title="GitHub"
        class="hidden h-8 w-8 items-center justify-center rounded-lg text-ink-muted transition-colors hover:bg-surface-muted hover:text-ink sm:inline-flex"
      >
        <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            fill-rule="evenodd"
            clip-rule="evenodd"
            d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
          />
        </svg>
      </a>

      <a
        href={`mailto:${SITE.email}`}
        aria-label="Email"
        title="Email"
        class="hidden h-8 w-8 items-center justify-center rounded-lg text-ink-muted transition-colors hover:bg-surface-muted hover:text-ink sm:inline-flex"
      >
        <svg
          class="h-[18px] w-[18px]"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="3" y="5" width="18" height="14" rx="2" />
          <path d="m3 7 9 6 9-6" />
        </svg>
      </a>

      <a
        href="/rss.xml"
        aria-label="RSS Feed"
        title="RSS Feed"
        class="hidden h-8 w-8 items-center justify-center rounded-lg text-ink-muted transition-colors hover:bg-surface-muted hover:text-ink sm:inline-flex"
      >
        <svg
          class="h-[17px] w-[17px]"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M4 11a9 9 0 0 1 9 9" />
          <path d="M4 4a16 16 0 0 1 16 16" />
          <circle cx="5" cy="19" r="1" fill="currentColor" />
        </svg>
      </a>

      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle color theme"
        class="inline-flex h-8 w-8 items-center justify-center rounded-lg text-ink-muted transition-colors hover:bg-surface-muted hover:text-ink"
      >
        <svg
          id="icon-sun"
          class="hidden h-[18px] w-[18px]"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2" />
          <path d="M12 20v2" />
          <path d="m4.93 4.93 1.41 1.41" />
          <path d="m17.66 17.66 1.41 1.41" />
          <path d="M2 12h2" />
          <path d="M20 12h2" />
          <path d="m6.34 17.66-1.41 1.41" />
          <path d="m19.07 4.93-1.41 1.41" />
        </svg>
        <svg
          id="icon-moon"
          class="h-[17px] w-[17px]"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
        </svg>
      </button>
    </nav>
  </div>
</header>

<style>
  @media (prefers-color-scheme: dark) {
    :global(:root:not(:has(> head > meta[name="color-scheme"][content="light"]))) #icon-sun {
      display: block;
    }
    :global(:root:not(:has(> head > meta[name="color-scheme"][content="light"]))) #icon-moon {
      display: none;
    }
  }
  :global(:root:has(> head > meta[name="color-scheme"][content="dark"])) #icon-sun {
    display: block;
  }
  :global(:root:has(> head > meta[name="color-scheme"][content="dark"])) #icon-moon {
    display: none;
  }
</style>
