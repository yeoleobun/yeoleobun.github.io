---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SITE } from "@/site";
---

<BaseLayout title={`404 — ${SITE.title}`} activeNav="home">
  <section
    class="mx-auto flex max-w-3xl flex-col items-start px-4 py-24 sm:px-6"
  >
    <p class="font-mono text-sm font-medium text-accent">404</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
      Page not found
    </h1>
    <p class="mt-3 text-base text-ink-muted">
      The page you requested doesn't exist or may have moved.
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a
        href="/"
        class="inline-flex items-center gap-1.5 rounded-lg bg-ink px-4 py-2 text-sm font-medium text-canvas transition-opacity hover:opacity-90"
      >
        <span>← Back to Home</span>
      </a>
      <a
        href="/posts/"
        class="inline-flex items-center gap-1.5 rounded-lg border border-line bg-surface px-4 py-2 text-sm font-medium text-ink transition-colors hover:bg-surface-muted"
      >
        <span>Browse Writing</span>
      </a>
    </div>
  </section>
</BaseLayout>
